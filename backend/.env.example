# Nexia Backend Configuration Template
PROJECT_NAME=Nexia
API_V1_PREFIX=/api/v1
VERSION=0.1.0

# Database (PostgreSQL 17 + pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/nexiav01
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_CONNECT_TIMEOUT=10
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=15.0
DB_PRE_PING=true

# Ollama Services
OLLAMA_BASE_URL=http://localhost:11434

# Embedding Model (Ollama nomic-embed-text)
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=32

# LLM Answer Generation (Ollama gemma3:4b CPU Optimized)
LLM_MODEL=gemma3:4b
LLM_TIMEOUT_SECONDS=360
LLM_MAX_EVIDENCE_PASSAGES=3
LLM_TEMPERATURE=0.1
LLM_NUM_THREADS=6
LLM_NUM_CTX=6144
LLM_NUM_PREDICT=768
LLM_KEEP_ALIVE=30m

# Retrieval Tuning
VECTOR_SEARCH_CANDIDATES=20
KEYWORD_SEARCH_CANDIDATES=20
HYBRID_TOP_K=10

# Adaptive NLP
ADAPTIVE_RETRIEVAL_ENABLED=true
MAX_SUBQUERIES_PER_COMPLEX_QUERY=4
COMPLEX_QUERY_TOP_K_PER_SUBQUERY=4

# Cache Policy
CACHE_FRESHNESS_DAYS=7
CACHE_STALE_ON_FAILURE=use_existing

# =========================================================================
# Performance Optimization & Scalability Settings
# =========================================================================

# Rate Limiting (Token Bucket)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_FAIL_OPEN=true
RATE_LIMIT_ANSWER_CAPACITY=2
RATE_LIMIT_ANSWER_REFILL_SECONDS=30.0
RATE_LIMIT_CONV_CREATE_CAPACITY=10
RATE_LIMIT_CONV_CREATE_REFILL_SECONDS=2.0
RATE_LIMIT_CONV_READ_CAPACITY=30
RATE_LIMIT_CONV_READ_REFILL_SECONDS=1.0

# Inference Admission & Bounded Queue
INFERENCE_MAX_ACTIVE=1
INFERENCE_MAX_QUEUE=3
INFERENCE_QUEUE_TIMEOUT=30.0

# Tiered Caching (InMemory / Redis)
CACHE_ENABLED=true
CACHE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
CACHE_DEFAULT_TTL_SECONDS=3600
CACHE_WIKI_METADATA_TTL_SECONDS=86400
CACHE_RETRIEVAL_TTL_SECONDS=3600
CACHE_CONVERSATIONS_TTL_SECONDS=300

# Request Deduplication & Idempotency
IDEMPOTENCY_ENABLED=true
IDEMPOTENCY_TTL_SECONDS=300

# Shared Async HTTP Client Pool
HTTP_POOL_MAX_CONNECTIONS=50
HTTP_POOL_MAX_KEEPALIVE_CONNECTIONS=10
HTTP_POOL_KEEPALIVE_EXPIRY=30.0

# Observability & Metrics
METRICS_ENABLED=true
CORRELATION_HEADER_NAME=X-Request-ID
