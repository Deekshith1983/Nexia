# Nexia Backend Configuration
PROJECT_NAME=Nexia
API_V1_PREFIX=/api/v1
VERSION=0.1.0

# Database (PostgreSQL 17 + pgvector)
# Replace <username> and <password> with your actual PostgreSQL credentials
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/nexiav01
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_CONNECT_TIMEOUT=10

# Ollama Services
OLLAMA_BASE_URL=http://localhost:11434

# Embedding Model (Ollama nomic-embed-text)
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=16

# LLM Answer Generation (Ollama gemma3:4b)
LLM_MODEL=gemma3:4b
LLM_TIMEOUT_SECONDS=90
LLM_MAX_EVIDENCE_PASSAGES=6
LLM_TEMPERATURE=0.1

# Retrieval Tuning
VECTOR_SEARCH_CANDIDATES=20
KEYWORD_SEARCH_CANDIDATES=20
HYBRID_TOP_K=10

# Cache Policy
CACHE_FRESHNESS_DAYS=7
CACHE_STALE_ON_FAILURE=use_existing
